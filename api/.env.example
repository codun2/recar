APP_NAME="Sayyar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://recar.smartunita.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=recar-db
DB_PORT=3306
DB_DATABASE=recar
DB_USERNAME=recar
DB_PASSWORD=recar

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@recar.smartunita.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=recar.smartunita.com
